# XRP Ledger network the cell settles on: devnet or testnet
HANDS_NETWORK=devnet

# Where the dashboard reads from. The key is the project's service role key: the cell writes, the dashboard only reads.
HANDS_SUPABASE_URL=
HANDS_SUPABASE_KEY=

# Vision-language selection of the object a job names. Without a key the cell falls back to colour matching.
ANTHROPIC_API_KEY=

# Optional integrations
CONTEXT_DEV_API_KEY=
ELEVENLABS_API_KEY=

# Camera index as OpenCV enumerates it (the wrist camera is usually 0 when it is the only USB camera)
HANDS_CAMERA_INDEX=0

# Public URL of the job API when it is exposed through a tunnel
HANDS_PUBLIC_URL=
